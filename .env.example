# demo (development only) or supabase. Never deploy demo with real submissions.
ITISPOT_MODE=demo
APP_ORIGIN=http://localhost:3000
DATA_DIR=.data

# Supabase server-side only. No service key is sent to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_USER_IDS=

# Required for public Supabase mode. Generate a random 32+ character secret.
RATE_LIMIT_SECRET=
# Only set if your hosting proxy OVERWRITES this header, e.g. x-vercel-forwarded-for on Vercel.
TRUSTED_IP_HEADER=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Hostname returned by Turnstile, without protocol (e.g. itispot.it)
TURNSTILE_HOSTNAME=
