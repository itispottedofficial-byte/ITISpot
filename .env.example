# demo (development only) or supabase. Never deploy demo with real submissions.
ITISPOT_MODE=demo
APP_ORIGIN=http://127.0.0.1:3187
DATA_DIR=.data

# Supabase server-side only. No service key is sent to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_USER_IDS=

# Required for public Supabase mode. Generate a random 32+ character secret.
RATE_LIMIT_SECRET=
# Production: required, and MUST be overwritten by your trusted hosting proxy.
# On Cloudflare Workers set cf-connecting-ip. Never trust headers on a direct Node server.
TRUSTED_IP_HEADER=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Hostname returned by Turnstile, without protocol (e.g. itispot.it)
TURNSTILE_HOSTNAME=

# Public operator details displayed on /privacy. Complete before accepting real content.
OPERATOR_NAME=
CONTACT_EMAIL=
